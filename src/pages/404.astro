---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/global/PageHero.astro';
import Button from '@components/global/Button.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you are looking for does not exist. Browse the research, publications, and contact pages of Fabio Bacchini."
>
  <meta name="robots" content="noindex" slot="head" />

  <PageHero
    title="Page Not Found"
    subtitle="The page you requested does not exist or has been moved."
    accentColor="pink"
  >
    <span class="text-xs font-medium tracking-wider uppercase">Error 404</span>
  </PageHero>

  <section class="py-16 md:py-24">
    <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-6 px-6 text-center">
      <p class="max-w-xl text-text-secondary leading-relaxed">
        You can go back to the homepage or explore the research projects and publications.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="/" variant="primary" size="lg">Back to Home</Button>
        <Button href="/research/" variant="ghost" size="lg">Research</Button>
        <Button href="/publications/" variant="ghost" size="lg">Publications</Button>
      </div>
    </div>
  </section>
</BaseLayout>
